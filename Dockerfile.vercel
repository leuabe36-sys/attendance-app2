FROM python:3.12-slim

# opencv-python-headless still dynamically links against these graphics/GL
# libraries at import time, even though it never opens a display. Vercel's
# plain Python runtime has no way to install system packages, which is what
# was causing: "ImportError: libGL.so.1: cannot open shared object file".
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY api/app.py app.py

# Vercel injects PORT (default 80) and expects the container to listen on it.
CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT:-80} --workers 2 --threads 4 --timeout 120 app:app"]
